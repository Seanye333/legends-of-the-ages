{
  "name": "qiangu-legends",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit-all": "npm run audit-en && npm run audit-zh && npm run audit-generals",
    "audit-en": "node --import tsx scripts/audit-en.ts",
    "audit-generals": "node --import tsx scripts/audit-generals.ts",
