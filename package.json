    "pool-snapshot": "node --import tsx scripts/pool-snapshot.ts",
    "preview": "vite preview",
    "price-cards": "node --import tsx scripts/price-cards.ts",
    "replay-diff": "node --import tsx scripts/replay-diff.ts",
    "seed-mechanics": "node --import tsx scripts/seed-mechanics.ts",
    "sim-ai-tiers": "node --import tsx scripts/sim-ai-tiers.ts",
    "sim-balance": "node --import tsx scripts/sim-balance.ts",
    "sim-body": "node --import tsx scripts/sim-body.ts",
    "sim-campaign": "node --import tsx scripts/sim-campaign.ts",
    "sim-cards": "node --import tsx scripts/sim-cards.ts",
    "sim-firstplayer": "node --import tsx scripts/sim-firstplayer.ts",
    "sim-hero-mirror": "node --import tsx scripts/sim-hero-mirror.ts",
    "sim-history": "node --import tsx scripts/sim-history.ts",
    "synth-deltas": "node --import tsx scripts/synth-deltas.ts",
    "tauri": "tauri",
    "test": "vitest run",
    "theme-audit": "node --import tsx scripts/theme-audit.ts",
    "tune-campaign": "node --import tsx scripts/tune-campaign.ts",
    "tune-history": "node --import tsx scripts/tune-history.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.server.json && tsc -p tsconfig.drivetest.json && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.112.0"
