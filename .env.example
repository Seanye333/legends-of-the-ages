# 联机服务器地址(不带协议头 —— protocol.ts 自己拼 wss:// / https://)。
# 不配的话默认 localhost:8787,也就是「联机不可用」。
# 部署步骤见 DEPLOY.md。
VITE_MATCH_SERVER=qiangu-server.your-subdomain.workers.dev

# 立绘 CDN(可选)。不配时非签名卡走随包的 200px 缩略图,
# 缺图再退化到拓印兜底 —— 不会有 404 风暴(见 src/ui/portraitSource.ts)。
# VITE_PORTRAIT_CDN=https://cdn.example.com/portraits
