                                <rect key="frame" x="107" y="428" width="200" height="40"/>
                                <fontDescription key="fontDescription" name="Songti SC" family="Songti SC" pointSize="34"/>
                                <color key="textColor" red="0.90980392156862744" green="0.78431372549019607" blue="0.47058823529411764" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
